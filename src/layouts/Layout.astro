---
import { BookOpen, Menu, X, Home, Book, Code2, Compass, Users } from 'lucide-react';
import Search from '../components/Search';
import ThemeToggle from '../components/ThemeToggle';
import { COLOR_MODES, DEFAULT_COLOR_MODE, DEFAULT_THEME_ID, THEMES } from '../utils/themes';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const themeIds = THEMES.map((theme) => theme.id);
const colorModes = COLOR_MODES.map((mode) => mode.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600;7..72,700;7..72,800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
      // Force hoisted script generation
      console.log("LibreUni: Production bundle active");
    </script>
    <script is:inline define:vars={{ themeIds, colorModes, defaultThemeId: DEFAULT_THEME_ID, defaultColorMode: DEFAULT_COLOR_MODE }}>
      const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
      const storedColorMode = typeof localStorage !== 'undefined' ? localStorage.getItem('color-mode') : null;
      const theme = themeIds.includes(storedTheme) ? storedTheme : defaultThemeId;
      const colorMode = colorModes.includes(storedColorMode) ? storedColorMode : defaultColorMode;
      const hour = new Date().getHours();
      const isDark = colorMode === 'dark' || (colorMode === 'auto' && (hour >= 22 || hour < 7));

      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.colorMode = colorMode;
      document.documentElement.classList.toggle('dark', isDark);
      window.localStorage.setItem('theme', theme);
      window.localStorage.setItem('color-mode', colorMode);
    </script>
  </head>
  <body class="bg-light-bg dark:bg-dark-bg min-h-screen font-sans text-light-text dark:text-dark-text antialiased scroll-smooth">
    <!-- Top Navigation Bar -->
    <header class="nav-fixed-header bg-light-bg dark:bg-dark-surface border-b border-light-border dark:border-dark-border flex items-center justify-between px-4 md:px-6">
      <div class="flex items-center gap-4 md:gap-8">
        <a href={import.meta.env.BASE_URL} class="flex min-h-11 items-center gap-2 md:gap-3 group">
            <div class="bg-primary p-1.5 md:p-2 rounded-lg md:rounded-xl shadow-lg shadow-primary/30 transform group-hover:rotate-6 transition-transform">
                <BookOpen size={18} className="text-white md:w-5 md:h-5" />
            </div>
            <span class="text-lg md:text-xl font-black tracking-tighter text-light-text dark:text-dark-text shrink-0">LibreUni</span>
        </a>
        <nav class="hidden md:flex items-center gap-2">
            <a href={import.meta.env.BASE_URL} class="min-h-11 px-4 py-2 hover:bg-light-accent/5 dark:hover:bg-dark-accent/5 rounded-xl text-sm font-bold transition-all">Home</a>
            <a href={`${import.meta.env.BASE_URL}courses`} class="min-h-11 px-4 py-2 hover:bg-light-accent/5 dark:hover:bg-dark-accent/5 rounded-xl text-sm font-bold transition-all">Courses</a>
            <a href={`${import.meta.env.BASE_URL}careers`} class="min-h-11 px-4 py-2 hover:bg-light-accent/5 dark:hover:bg-dark-accent/5 rounded-xl text-sm font-bold transition-all">Learning Paths</a>
            <a href={`${import.meta.env.BASE_URL}development`} class="min-h-11 px-4 py-2 hover:bg-light-accent/5 dark:hover:bg-dark-accent/5 rounded-xl text-sm font-bold transition-all">Development</a>
            <a href={`${import.meta.env.BASE_URL}about`} class="min-h-11 px-4 py-2 hover:bg-light-accent/5 dark:hover:bg-dark-accent/5 rounded-xl text-sm font-bold transition-all">About</a>
        </nav>
      </div>

      <div class="flex items-center gap-2 md:gap-4 flex-1 justify-end">
         <div class="hidden md:block flex-1 max-w-md">
            <Search client:load baseUrl={import.meta.env.BASE_URL} />
         </div>
         <div class="flex items-center gap-2 md:gap-2">
            <ThemeToggle client:load />
            <button 
                id="mobile-menu-toggle"
                class="min-h-11 min-w-11 p-2 md:p-2.5 hover:bg-light-accent/10 dark:hover:bg-dark-accent/10 rounded-xl transition-colors md:hidden text-light-text dark:text-dark-text border border-light-border dark:border-dark-border"
                aria-label="Toggle Menu"
            >
                <span id="menu-icon"><Menu size={20} /></span>
                <span id="close-icon" class="hidden"><X size={20} /></span>
            </button>
         </div>
      </div>
    </header>

    <!-- Mobile Navigation Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-[90] bg-light-bg dark:bg-dark-bg transition-all duration-500 translate-x-full md:hidden pt-24 px-8 overflow-y-auto pointer-events-none">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-light-accent dark:from-dark-accent via-transparent to-transparent"></div>
        
        <div class="relative z-10 flex flex-col gap-10">
            <div class="space-y-4">
                <p class="text-[10px] font-black text-light-muted dark:text-dark-muted uppercase tracking-[0.2em]">Navigation</p>
                <div class="grid grid-cols-1 gap-4">
                    <a href={import.meta.env.BASE_URL} class="flex items-center gap-4 p-6 bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border rounded-3xl group active:scale-95 transition-all">
                        <div class="p-3 bg-light-accent/5 dark:bg-dark-accent/5 rounded-2xl text-light-accent dark:text-dark-accent">
                            <Home size={24} />
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-black">Home</span>
                            <span class="text-xs font-bold text-light-muted dark:text-dark-muted">Return to dashboard</span>
                        </div>
                    </a>
                    <a href={`${import.meta.env.BASE_URL}courses`} class="flex items-center gap-4 p-6 bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border rounded-3xl group active:scale-95 transition-all">
                        <div class="p-3 bg-primary/10 rounded-2xl text-primary">
                            <Book size={24} />
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-black">Courses</span>
                            <span class="text-xs font-bold text-light-muted dark:text-dark-muted">Browse all courses</span>
                        </div>
                    </a>
                    <a href={`${import.meta.env.BASE_URL}careers`} class="flex items-center gap-4 p-6 bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border rounded-3xl group active:scale-95 transition-all">
                        <div class="p-3 bg-primary/10 rounded-2xl text-primary">
                            <Compass size={24} />
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-black">Learning Paths</span>
                            <span class="text-xs font-bold text-light-muted dark:text-dark-muted">Connect courses through assessed work</span>
                        </div>
                    </a>
                    <a href={`${import.meta.env.BASE_URL}about`} class="flex items-center gap-4 p-6 bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border rounded-3xl group active:scale-95 transition-all">
                        <div class="p-3 bg-primary/10 rounded-2xl text-primary">
                            <Users size={24} />
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-black">About</span>
                            <span class="text-xs font-bold text-light-muted dark:text-dark-muted">LibreUni's mission</span>
                        </div>
                    </a>
                    <a href={`${import.meta.env.BASE_URL}development`} class="flex items-center gap-4 p-6 bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border rounded-3xl group active:scale-95 transition-all">
                        <div class="p-3 bg-primary/10 rounded-2xl text-primary">
                            <Code2 size={24} />
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-black">Development</span>
                            <span class="text-xs font-bold text-light-muted dark:text-dark-muted">Quality reports and course metrics</span>
                        </div>
                    </a>
                </div>
            </div>

            <div class="space-y-4">
                <p class="text-[10px] font-black text-light-muted dark:text-dark-muted uppercase tracking-[0.2em]">Search Knowledge</p>
                <Search client:load baseUrl={import.meta.env.BASE_URL} />
            </div>

            <div class="mt-auto py-12 text-center">
                <p class="text-[10px] font-black text-light-muted dark:text-dark-muted uppercase tracking-[0.2em] opacity-40">© 2026 LIBREUNI PROJECT</p>
            </div>
        </div>
    </div>

    <!-- Mobile Sidebar Backdrop (for lessons) -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[45] hidden transition-opacity opacity-0"></div>

    <div class="flex min-h-screen relative pt-16">
      <slot />
    </div>

    <script is:inline>
        const menuToggle = document.getElementById('mobile-menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');

        menuToggle?.addEventListener('click', () => {
            const isOpen = !mobileMenu.classList.contains('translate-x-full');
            if (isOpen) {
                mobileMenu.classList.add('translate-x-full');
                mobileMenu.classList.add('pointer-events-none');
                menuIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
                document.body.style.overflow = '';
            } else {
                mobileMenu.classList.remove('translate-x-full');
                mobileMenu.classList.remove('pointer-events-none');
                menuIcon.classList.add('hidden');
                closeIcon.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        });

        // Close menu on link clicks
        mobileMenu?.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('translate-x-full');
                mobileMenu.classList.add('pointer-events-none');
                menuIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
                document.body.style.overflow = '';
            });
        });

        // Interactive diagram canvas controls (Ctrl/Cmd + wheel zoom, drag pan, toolbar controls)
        const DIAGRAM_MIN_SCALE = 1;
        const DIAGRAM_MAX_SCALE = 5;
        const DIAGRAM_STEP = 1.25;
        const isMacPlatform = /Mac|iPhone|iPod|iPad/i.test(navigator.platform || navigator.userAgent || '');
        const modKeyLabel = isMacPlatform ? '⌘' : 'Ctrl';
        let hoveredDiagramController = null;

        function initDiagramFrame(frame) {
            if (!(frame instanceof HTMLElement) || frame.dataset.diagramInteractive === 'true') return;
            const render = frame.querySelector('.diagram-render');
            if (!(render instanceof HTMLElement)) return;
            const getTarget = () => render.querySelector(':scope > svg, :scope > img');
            if (!getTarget()) return;

            frame.dataset.diagramInteractive = 'true';

            const zoomOutBtn = frame.querySelector('[data-diagram-action="zoom-out"]');
            const zoomResetBtn = frame.querySelector('[data-diagram-action="reset"]');
            const zoomInBtn = frame.querySelector('[data-diagram-action="zoom-in"]');
            const hintEl = frame.querySelector('.diagram-zoom-hint');

            if (hintEl) {
                hintEl.textContent = `${modKeyLabel} + scroll to zoom`;
            }
            if (zoomOutBtn) zoomOutBtn.setAttribute('title', `Zoom out (${modKeyLabel} + −)`);
            if (zoomResetBtn) zoomResetBtn.setAttribute('title', `Reset view (${modKeyLabel} + 0)`);
            if (zoomInBtn) zoomInBtn.setAttribute('title', `Zoom in (${modKeyLabel} + +)`);

            const state = {
                scale: 1,
                tx: 0,
                ty: 0,
                hintTimer: null,
                wheelTimer: null,
                panStart: null,
                activePointers: new Map(),
                pinchStartDist: 0,
                pinchStartScale: 1,
                pinchStartMid: null,
                pinchStartTx: 0,
                pinchStartTy: 0,
            };

            function clampPan(nextTx, nextTy, nextScale) {
                const rect = render.getBoundingClientRect();
                const maxX = Math.max(0, rect.width * Math.max(1, nextScale) * 0.65);
                const maxY = Math.max(0, rect.height * Math.max(1, nextScale) * 0.65);
                return [
                    Math.max(-maxX, Math.min(maxX, nextTx)),
                    Math.max(-maxY, Math.min(maxY, nextTy)),
                ];
            }

            function hideHint() {
                if (!hintEl) return;
                if (state.hintTimer) {
                    clearTimeout(state.hintTimer);
                    state.hintTimer = null;
                }
                hintEl.classList.remove('is-visible');
            }

            function showHint() {
                if (!hintEl) return;
                hintEl.classList.add('is-visible');
                if (state.hintTimer) clearTimeout(state.hintTimer);
                state.hintTimer = setTimeout(() => {
                    hintEl.classList.remove('is-visible');
                    state.hintTimer = null;
                }, 1300);
            }

            function applyTransform() {
                const target = getTarget();
                if (!target) return;
                const isTransformed = state.scale > 1.01 || Math.abs(state.tx) > 0.5 || Math.abs(state.ty) > 0.5;

                if (!isTransformed) {
                    state.scale = 1;
                    state.tx = 0;
                    state.ty = 0;
                    target.style.transform = '';
                } else {
                    target.style.transform = `translate3d(${state.tx.toFixed(2)}px, ${state.ty.toFixed(2)}px, 0) scale(${state.scale.toFixed(4)})`;
                }

                frame.classList.toggle('is-transformed', isTransformed);
                if (zoomResetBtn) {
                    zoomResetBtn.textContent = `${Math.round(state.scale * 100)}%`;
                }
                if (zoomOutBtn instanceof HTMLButtonElement) {
                    zoomOutBtn.disabled = state.scale <= DIAGRAM_MIN_SCALE + 0.005;
                }
                if (zoomInBtn instanceof HTMLButtonElement) {
                    zoomInBtn.disabled = state.scale >= DIAGRAM_MAX_SCALE - 0.005;
                }
            }

            function zoomTo(nextScale, clientX, clientY, immediate = false) {
                let clampedScale = Math.max(DIAGRAM_MIN_SCALE, Math.min(DIAGRAM_MAX_SCALE, nextScale));
                if (Math.abs(clampedScale - 1) < 0.04) {
                    clampedScale = 1;
                }
                if (Math.abs(clampedScale - state.scale) < 0.0005) return;

                if (clampedScale === 1) {
                    resetZoom();
                    return;
                }

                const rect = render.getBoundingClientRect();
                const hasPoint = typeof clientX === 'number' && typeof clientY === 'number';
                const cx = hasPoint ? clientX - (rect.left + rect.width / 2) : 0;
                const cy = hasPoint ? clientY - (rect.top + rect.height / 2) : 0;
                const ratio = clampedScale / state.scale;
                const nextTx = cx - (cx - state.tx) * ratio;
                const nextTy = cy - (cy - state.ty) * ratio;

                if (immediate) {
                    frame.classList.add('is-wheel-zooming');
                    if (state.wheelTimer) clearTimeout(state.wheelTimer);
                    state.wheelTimer = setTimeout(() => {
                        frame.classList.remove('is-wheel-zooming');
                        state.wheelTimer = null;
                    }, 120);
                } else {
                    frame.classList.remove('is-wheel-zooming');
                }

                state.scale = clampedScale;
                [state.tx, state.ty] = clampPan(nextTx, nextTy, clampedScale);
                applyTransform();
            }

            function resetZoom() {
                frame.classList.remove('is-wheel-zooming', 'is-dragging');
                state.scale = 1;
                state.tx = 0;
                state.ty = 0;
                applyTransform();
            }

            const controller = { frame, zoomTo, resetZoom, getScale: () => state.scale };
            frame.addEventListener('mouseenter', () => { hoveredDiagramController = controller; });
            frame.addEventListener('mouseleave', () => {
                if (hoveredDiagramController === controller) hoveredDiagramController = null;
            });

            render.addEventListener('wheel', (event) => {
                if (event.ctrlKey || event.metaKey) {
                    event.preventDefault();
                    hideHint();
                    let deltaY = event.deltaY;
                    if (event.deltaMode === 1) deltaY *= 16;
                    else if (event.deltaMode === 2) deltaY *= 100;
                    const clampedDelta = Math.max(-120, Math.min(120, deltaY));
                    const sensitivity = Math.abs(deltaY) < 40 ? 0.008 : 0.0025;
                    const factor = Math.exp(-clampedDelta * sensitivity);
                    zoomTo(state.scale * factor, event.clientX, event.clientY, true);
                } else if (Math.abs(event.deltaY) > 2) {
                    showHint();
                }
            }, { passive: false });

            render.addEventListener('dragstart', (event) => event.preventDefault());

            render.addEventListener('pointerdown', (event) => {
                if (event.pointerType === 'mouse' && event.button !== 0 && event.button !== 1) return;
                if (event.target instanceof Element && event.target.closest('a, button, summary, details')) return;

                if (event.pointerType === 'touch') {
                    state.activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
                    if (state.activePointers.size === 2) {
                        const pts = Array.from(state.activePointers.values());
                        state.pinchStartDist = Math.hypot(pts[1].x - pts[0].x, pts[1].y - pts[0].y);
                        state.pinchStartScale = state.scale;
                        state.pinchStartMid = { x: (pts[0].x + pts[1].x) / 2, y: (pts[0].y + pts[1].y) / 2 };
                        state.pinchStartTx = state.tx;
                        state.pinchStartTy = state.ty;
                        state.panStart = null;
                        frame.classList.add('is-dragging');
                        return;
                    }
                    if (state.scale <= 1.005) return;
                }

                state.panStart = {
                    pointerId: event.pointerId,
                    x: event.clientX,
                    y: event.clientY,
                    tx: state.tx,
                    ty: state.ty,
                    moved: false,
                };
            });

            render.addEventListener('pointermove', (event) => {
                if (state.activePointers.has(event.pointerId)) {
                    state.activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
                    if (state.activePointers.size === 2 && state.pinchStartDist > 8 && state.pinchStartMid) {
                        const pts = Array.from(state.activePointers.values());
                        const dist = Math.hypot(pts[1].x - pts[0].x, pts[1].y - pts[0].y);
                        const mid = { x: (pts[0].x + pts[1].x) / 2, y: (pts[0].y + pts[1].y) / 2 };
                        const nextScale = Math.max(DIAGRAM_MIN_SCALE, Math.min(DIAGRAM_MAX_SCALE, state.pinchStartScale * (dist / state.pinchStartDist)));
                        const rect = render.getBoundingClientRect();
                        const cx = state.pinchStartMid.x - (rect.left + rect.width / 2);
                        const cy = state.pinchStartMid.y - (rect.top + rect.height / 2);
                        const ratio = nextScale / state.pinchStartScale;
                        const nextTx = cx - (cx - state.pinchStartTx) * ratio + (mid.x - state.pinchStartMid.x);
                        const nextTy = cy - (cy - state.pinchStartTy) * ratio + (mid.y - state.pinchStartMid.y);
                        state.scale = nextScale;
                        [state.tx, state.ty] = clampPan(nextTx, nextTy, nextScale);
                        applyTransform();
                        return;
                    }
                }

                if (!state.panStart || event.pointerId !== state.panStart.pointerId) return;
                const dx = event.clientX - state.panStart.x;
                const dy = event.clientY - state.panStart.y;
                if (!state.panStart.moved && Math.hypot(dx, dy) > 2) {
                    state.panStart.moved = true;
                    frame.classList.add('is-dragging');
                    try { render.setPointerCapture(event.pointerId); } catch {}
                }
                if (state.panStart.moved) {
                    [state.tx, state.ty] = clampPan(state.panStart.tx + dx, state.panStart.ty + dy, state.scale);
                    applyTransform();
                }
            });

            function endPointer(event) {
                state.activePointers.delete(event.pointerId);
                if (state.panStart && event.pointerId === state.panStart.pointerId) {
                    if (state.panStart.moved) {
                        try { render.releasePointerCapture(event.pointerId); } catch {}
                    }
                    state.panStart = null;
                }
                if (state.activePointers.size < 2 && !state.panStart) {
                    frame.classList.remove('is-dragging');
                }
            }

            render.addEventListener('pointerup', endPointer);
            render.addEventListener('pointercancel', endPointer);

            render.addEventListener('dblclick', (event) => {
                if (event.target instanceof Element && event.target.closest('a, button, summary, details')) return;
                event.preventDefault();
                if (event.shiftKey) {
                    zoomTo(state.scale / 1.6, event.clientX, event.clientY, false);
                } else if (state.scale >= DIAGRAM_MAX_SCALE - 0.05) {
                    resetZoom();
                } else {
                    zoomTo(state.scale * 1.6, event.clientX, event.clientY, false);
                }
            });

            zoomInBtn?.addEventListener('click', (event) => {
                event.stopPropagation();
                zoomTo(state.scale * DIAGRAM_STEP);
            });
            zoomOutBtn?.addEventListener('click', (event) => {
                event.stopPropagation();
                zoomTo(state.scale / DIAGRAM_STEP);
            });
            zoomResetBtn?.addEventListener('click', (event) => {
                event.stopPropagation();
                resetZoom();
            });

            applyTransform();
        }

        document.querySelectorAll('.diagram-frame').forEach(initDiagramFrame);

        document.addEventListener('keydown', (event) => {
            if (event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable="true"]')) return;
            const focusedFrame = document.activeElement instanceof Element ? document.activeElement.closest('.diagram-frame') : null;
            if (!focusedFrame) return;

            if ((event.ctrlKey || event.metaKey) && (event.key === '+' || event.key === '=')) {
                event.preventDefault();
                focusedFrame.querySelector('[data-diagram-action="zoom-in"]')?.click();
            } else if ((event.ctrlKey || event.metaKey) && (event.key === '-' || event.key === '_')) {
                event.preventDefault();
                focusedFrame.querySelector('[data-diagram-action="zoom-out"]')?.click();
            } else if ((event.ctrlKey || event.metaKey) && event.key === '0') {
                event.preventDefault();
                focusedFrame.querySelector('[data-diagram-action="reset"]')?.click();
            }
        });

        // Copy button generic logic
        document.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const copyBtn = target.closest('.diagram-copy-button');
            if (copyBtn) {
                const code = copyBtn.getAttribute('data-code');
                if (code) {
                    navigator.clipboard.writeText(code);
                    const originalText = copyBtn.innerHTML;
                    copyBtn.innerHTML = 'Copied!';
                    setTimeout(() => copyBtn.innerHTML = originalText, 2000);
                }
                return;
            }
        });

        // Ensure tables are keyboard accessible when scrollable
        document.querySelectorAll('table').forEach((table) => {
            if (!table.hasAttribute('tabindex')) {
                table.setAttribute('tabindex', '0');
                table.setAttribute('role', 'region');
                table.setAttribute('aria-label', table.getAttribute('aria-label') || 'Data table');
            }
        });
    </script>

    <script>  const KEY = 'lu:dev-theme';
  const CATS = [
    { label:'Brand', vars:[{k:'--primary-rgb',l:'Primary'},{k:'--secondary-rgb',l:'Secondary'},{k:'--accent-rgb',l:'Accent'}] },
    { label:'Light', vars:[{k:'--light-bg-rgb',l:'BG'},{k:'--light-surface-rgb',l:'Surface'},{k:'--light-border-rgb',l:'Border'},{k:'--light-text-rgb',l:'Text'},{k:'--light-muted-rgb',l:'Muted'},{k:'--light-accent-rgb',l:'Accent'}] },
    { label:'Dark', vars:[{k:'--dark-bg-rgb',l:'BG'},{k:'--dark-surface-rgb',l:'Surface'},{k:'--dark-border-rgb',l:'Border'},{k:'--dark-text-rgb',l:'Text'},{k:'--dark-muted-rgb',l:'Muted'},{k:'--dark-accent-rgb',l:'Accent'}] },
  ];
  const FONTS = ['Plus Jakarta Sans','Literata','Space Grotesk'];

  function load() { try{return JSON.parse(localStorage.getItem(KEY))||{}}catch{return{}} }
  function read(k) {
    let o = load();
    if (o[k]) return o[k];
    return getComputedStyle(document.documentElement).getPropertyValue(k).trim();
  }
  function write(k, v) {
    let o = load();
    o[k] = v;
    localStorage.setItem(KEY, JSON.stringify(o));
    applyStyles();
  }
  function rgb2h(s) { let p=s.split(' ').map(Number); return '#'+p.map(v=>v.toString(16).padStart(2,'0')).join(''); }
  function h2r(h) { let m=/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(h); return m?`${parseInt(m[1],16)} ${parseInt(m[2],16)} ${parseInt(m[3],16)}`:null; }

  function applyStyles() {
    let styleEl = document.getElementById('lu-dev-themer-styles');
    if (!styleEl) {
      styleEl = document.createElement('style');
      styleEl.id = 'lu-dev-themer-styles';
      document.head.appendChild(styleEl);
    }
    const o = load();
    const curT = document.documentElement.dataset.theme || 'monochrome';
    const lightVars = [];
    const darkVars = [];
    const globalVars = [];
    
    Object.keys(o).forEach(k => {
      const val = o[k];
      if (k === '--font-sans') {
        globalVars.push(`${k}: ${val};`);
      } else if (k.startsWith('--light-')) {
        lightVars.push(`${k}: ${val};`);
        if (k.endsWith('-rgb')) {
          try { lightVars.push(`${k.slice(0, -4)}: ${rgb2h(val)};`); } catch(e){}
        }
      } else if (k.startsWith('--dark-')) {
        darkVars.push(`${k}: ${val};`);
        if (k.endsWith('-rgb')) {
          try { darkVars.push(`${k.slice(0, -4)}: ${rgb2h(val)};`); } catch(e){}
        }
      } else {
        globalVars.push(`${k}: ${val};`);
        if (k.endsWith('-rgb')) {
          try { globalVars.push(`${k.slice(0, -4)}: ${rgb2h(val)};`); } catch(e){}
        }
      }
    });

    let css = '';
    const lightSelector = curT === 'modern' ? 'html[data-theme="modern"], :root' : `html[data-theme="${curT}"]`;
    const darkSelector = curT === 'modern' ? 'html.dark' : `html.dark[data-theme="${curT}"]`;
    const globalSelector = curT === 'modern' ? ':root' : `html[data-theme="${curT}"]`;

    if (globalVars.length) css += `${globalSelector} {\n  ${globalVars.join('\n  ')}\n}\n`;
    if (lightVars.length) css += `${lightSelector} {\n  ${lightVars.join('\n  ')}\n}\n`;
    if (darkVars.length) css += `${darkSelector} {\n  ${darkVars.join('\n  ')}\n}\n`;
    styleEl.textContent = css;
  }

  function restore() { applyStyles(); }

  function applyTheme(id) { document.documentElement.dataset.theme=id; localStorage.setItem('theme',id); applyStyles(); }
  function applyMode(id) { 
    document.documentElement.dataset.colorMode=id; 
    let h=new Date().getHours(); 
    let isDark=id==='dark'||(id==='auto'&&(h>=22||h<7)); 
    document.documentElement.classList.toggle('dark',isDark); 
    localStorage.setItem('color-mode',id);
    applyStyles();
  }

